{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Symphra",
  "scopeName": "source.symphra",
  "fileTypes": [
    "sym"
  ],
  "comment": "Tracks the Draft 0.1 grammar in docs/language/draft-0.1.md. Keep in sync as the grammar grows.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#rates"
    },
    {
      "include": "#pitches"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.symphra",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.symphra",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.symphra",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.symphra",
          "match": "\\\\[\"\\\\n]"
        }
      ]
    },
    "rates": {
      "comment": "A number immediately followed by a unit identifier, e.g. 48khz, 150bpm.",
      "match": "\\b(\\d+(?:\\.\\d+)?)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "constant.numeric.symphra"
        },
        "2": {
          "name": "keyword.other.unit.symphra"
        }
      }
    },
    "pitches": {
      "comment": "A natural-note letter, an optional # or b accidental, and a decimal octave that may be negative (e.g. C4, C#4, Eb4, C-1, C#-1). An accidental not directly followed by octave digits (e.g. `C#` at end of line) is left for #comments to claim.",
      "match": "\\b([A-G])(#|b)?(-?\\d+)\\b",
      "captures": {
        "1": { "name": "constant.language.pitch.symphra" },
        "2": { "name": "keyword.operator.accidental.symphra" },
        "3": { "name": "constant.language.pitch.symphra" }
      }
    },
    "numbers": {
      "name": "constant.numeric.symphra",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.declaration.symphra",
          "match": "\\b(project|song|instrument|pattern|sequence|steps|sampled|sampler|choose|rhythm|track|section|master|limiter)\\b"
        },
        {
          "name": "keyword.control.statement.symphra",
          "match": "\\b(seed|sample_rate|output|tempo|meter|arrangement|key|sample|weight|source|root|pack|with|resolution|hit|role|play|trigger_with|gate|transpose|degree|octave|note|rest|chord|for|velocity|bar|layer|use|effect|delay|mix|time|feedback|bars|parallel|exact|ceiling)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.symphra",
          "match": "[{}]"
        },
        {
          "name": "keyword.operator.assignment.symphra",
          "match": "="
        },
        {
          "name": "keyword.operator.pipe.symphra",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.percent.symphra",
          "match": "%"
        },
        {
          "name": "keyword.operator.arithmetic.symphra",
          "match": "[/+-]"
        }
      ]
    }
  }
}
