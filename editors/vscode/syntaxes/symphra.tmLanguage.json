{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "symphra",
  "scopeName": "source.symphra",
  "fileTypes": [
    "sym"
  ],
  "comment": "Tracks TokenKind keywords and punctuation in crates/symphra-syntax/src/token.rs and lexer.rs. Keep in sync as the grammar grows.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#rates"
    },
    {
      "include": "#pitches"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.symphra",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.symphra",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.symphra",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.symphra",
          "match": "\\\\[\"\\\\n]"
        }
      ]
    },
    "rates": {
      "comment": "A number immediately followed by a unit identifier, e.g. 48khz, 150bpm, -5.2db.",
      "match": "\\b(\\d+(?:\\.\\d+)?)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "constant.numeric.symphra"
        },
        "2": {
          "name": "keyword.other.unit.symphra"
        }
      }
    },
    "pitches": {
      "comment": "A natural-note letter, an optional # or b accidental, and a decimal octave that may be negative (e.g. C4, C#4, Eb4, C-1, C#-1). An accidental not directly followed by octave digits (e.g. `C#` at end of line) is left for #comments to claim.",
      "match": "\\b([A-G])(#|b)?(-?\\d+)\\b",
      "captures": {
        "1": {
          "name": "constant.language.pitch.symphra"
        },
        "2": {
          "name": "keyword.operator.accidental.symphra"
        },
        "3": {
          "name": "constant.language.pitch.symphra"
        }
      }
    },
    "numbers": {
      "name": "constant.numeric.symphra",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.declaration.symphra",
          "match": "\\b(project|song|instrument|pattern|sequence|steps|sampled|sampler|drum_machine|soundfont|vst3|synth|supersaw|choose|rhythm|track|section|arrangement|master|limiter|arpeggiate)\\b"
        },
        {
          "name": "keyword.control.statement.symphra",
          "match": "\\b(seed|sample_rate|output|tempo|meter|key|sample|weight|source|root|pack|bank|drum|preset|with|resolution|hit|role|volume|play|trigger_with|gate|transpose|gain|repeat|fit|reverse|pan|alternate|chance|speed|retrigger|choose_sample|at|degree|octave|note|rest|chord|for|velocity|bar|step|style|octaves|layer|use|effect|delay|mix|time|feedback|filter|cutoff|resonance|reverb|size|automate|lfo|range|rate|cycles|bars|parallel|exact|ceiling|envelope|attack|decay|sustain|release|voices|detune|spread)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.symphra",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.symphra",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.symphra",
          "match": "[\\[\\]]"
        },
        {
          "name": "keyword.operator.assignment.symphra",
          "match": "="
        },
        {
          "name": "keyword.operator.pipe.symphra",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.symphra",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.percent.symphra",
          "match": "%"
        },
        {
          "name": "keyword.operator.arithmetic.symphra",
          "match": "[/+*-]"
        },
        {
          "name": "punctuation.separator.colon.symphra",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.symphra",
          "match": ","
        }
      ]
    }
  }
}