// aoharu-signal.sym
// Phase B of examples/draft-0.1/001-example.str (Strudel)
// "Kawaii Future Bass — Aoharu Signal"
//
// Structure: Intro 4 → Build 4 → Drop 8 → Outro 4 (20 bars @ 150bpm)
// Harmony: D major 4536 — Gmaj7 → A7 → F#m7 → Bm7
//
// Assets (paths relative to this file):
//   assets/TimGM6mb.sf2     — GM SoundFont (MusicBox / Warm Pad / Voice Oohs)
//   assets/riser.wav        — synthetic noise riser (gen_samples.py)
//   RolandTR909/{bd,cp,hh,oh,rim}.wav — synthetic drum one-shots (not real 909)
//
// Still simplified vs Strudel:
// - one effect per track (no reverb+delay stack)
// - no continuous pan/gain LFO; no degradeBy
// - square lead stays triangle; bass stays supersaw voices 1
// - drum samples are placeholders (swap for real TR-909 WAVs anytime)

project {
  seed 20260811
  sample_rate 48khz
  output stereo
}

song "Aoharu Signal" {
  tempo 150bpm
  meter 4/4
  key D major

  // ─────────────────────────────────────────────
  // Instruments
  // ─────────────────────────────────────────────

  instrument fb_saw = synth supersaw {
    voices 5
    detune 0.4
    spread 0.7

    envelope {
      attack 10ms
      decay 150ms
      sustain 0.3
      release 100ms
    }
  }

  instrument bass_saw = synth supersaw {
    voices 1
    detune 0
    spread 0

    envelope {
      attack 10ms
      decay 100ms
      sustain 0.6
      release 50ms
    }
  }

  // Strudel .s("gm_music_box")
  instrument music_box = soundfont {
    source "assets/TimGM6mb.sf2"
    preset "MusicBox"
  }

  // Strudel .s("gm_pad_2_warm")
  instrument warm_pad = soundfont {
    source "assets/TimGM6mb.sf2"
    preset "Warm Pad"
  }

  // Strudel .s("gm_voice_oohs")
  instrument voice_oohs = soundfont {
    source "assets/TimGM6mb.sf2"
    preset "Voice Oohs"
  }

  // Strudel square lead — still no square oscillator
  instrument lead_tone = triangle {
    envelope {
      attack 10ms
      decay 80ms
      sustain 0.4
      release 80ms
    }
  }

  instrument tr909 = drum_machine {
    bank "assets/RolandTR909"
  }

  // Strudel s("white").slow(4) — one-shot WAV held for 4 bars
  instrument riser_noise = sampled {
    source "assets/riser.wav"
    root C4
  }

  // ─────────────────────────────────────────────
  // Rhythms
  // ─────────────────────────────────────────────

  rhythm chord_stabs resolution 1/8 {
    hit rest rest hit rest rest hit rest
    hit rest rest hit rest rest hit hit
  }

  rhythm vox_hits resolution 1/8 {
    rest hit rest rest hit hit rest rest
  }

  rhythm bass_pulse resolution 1/16 {
    hit rest rest rest rest hit hit rest
    rest rest hit rest rest rest rest rest
  }

  // ─────────────────────────────────────────────
  // Harmonic material (4-bar phrase)
  // ─────────────────────────────────────────────

  pattern pad_chords = sequence {
    chord G3 B3 D4 F#4 for 1bar
    chord A3 C#4 E4 G4 for 1bar
    chord F#3 A3 C#4 E4 for 1bar
    chord B3 D4 F#4 A4 for 1bar
  }

  pattern drop_chords = sequence {
    chord G4 B4 D5 F#5 for 1bar
    chord A4 C#5 E5 G5 for 1bar
    chord F#4 A4 C#5 E5 for 1bar
    chord B4 D5 F#5 A5 for 1bar
  }

  pattern bass_roots = sequence {
    note G2 for 1bar
    note A2 for 1bar
    note F#2 for 1bar
    note B2 for 1bar
  }

  pattern arpeggio = sequence {
    note G4 for 1/8
    note B4 for 1/8
    note D5 for 1/8
    note F#5 for 1/8
    note G5 for 1/8
    note F#5 for 1/8
    note D5 for 1/8
    note B4 for 1/8

    note A4 for 1/8
    note C#5 for 1/8
    note E5 for 1/8
    note G5 for 1/8
    note A5 for 1/8
    note G5 for 1/8
    note E5 for 1/8
    note C#5 for 1/8

    note F#4 for 1/8
    note A4 for 1/8
    note C#5 for 1/8
    note E5 for 1/8
    note F#5 for 1/8
    note E5 for 1/8
    note C#5 for 1/8
    note A4 for 1/8

    note B4 for 1/8
    note D5 for 1/8
    note F#5 for 1/8
    note A5 for 1/8
    note B5 for 1/8
    note A5 for 1/8
    note F#5 for 1/8
    note D5 for 1/8
  }

  pattern lead_line = sequence {
    note D5 for 1/8
    note D5 for 1/16
    note E5 for 1/16
    note F#5 for 1/8
    note A5 for 1/8
    rest for 1/8
    note B5 for 1/8
    note A5 for 1/8
    note F#5 for 1/8

    note C#5 for 1/8
    note C#5 for 1/16
    note E5 for 1/16
    note G5 for 1/8
    note A5 for 1/8
    rest for 1/8
    note B5 for 1/8
    note A5 for 1/8
    note E5 for 1/8

    note A4 for 1/8
    note A4 for 1/16
    note C#5 for 1/16
    note E5 for 1/8
    note F#5 for 1/8
    rest for 1/8
    note A5 for 1/8
    note F#5 for 1/8
    note E5 for 1/8

    note B4 for 1/8
    note D5 for 1/8
    note F#5 for 1/8
    note A5 for 1/16
    note B5 for 1/16
    note A5 for 1/8
    note F#5 for 1/8
    note E5 for 1/8
    note D5 for 1/8
  }

  // ─────────────────────────────────────────────
  // Drum / riser patterns
  // ─────────────────────────────────────────────

  // Strudel lightDrums: hh*4 + late rim
  pattern light_hh = steps 1/4 {
    drum "hh" velocity 38
    drum "hh" velocity 38
    drum "hh" velocity 38
    drum "hh" velocity 38
  }

  pattern light_rim = steps 1/8 {
    rest
    rest
    rest
    rest
    rest
    rest
    rest
    drum "rim" velocity 64
  }

  // Strudel build: bd*4
  pattern four_on_floor = steps 1/4 {
    drum "bd" velocity 115
    drum "bd" velocity 115
    drum "bd" velocity 115
    drum "bd" velocity 115
  }

  // Strudel snareRoll: <cp*2 cp*4 cp*8 cp*16> over 4 bars (1/16 grid)
  pattern snare_roll = steps 1/16 {
    // bar 1 — cp*2
    drum "cp" velocity 70
    rest
    rest
    rest
    rest
    rest
    rest
    rest
    drum "cp" velocity 74
    rest
    rest
    rest
    rest
    rest
    rest
    rest

    // bar 2 — cp*4
    drum "cp" velocity 78
    rest
    rest
    rest
    drum "cp" velocity 80
    rest
    rest
    rest
    drum "cp" velocity 82
    rest
    rest
    rest
    drum "cp" velocity 84
    rest
    rest
    rest

    // bar 3 — cp*8
    drum "cp" velocity 86
    rest
    drum "cp" velocity 87
    rest
    drum "cp" velocity 88
    rest
    drum "cp" velocity 89
    rest
    drum "cp" velocity 90
    rest
    drum "cp" velocity 91
    rest
    drum "cp" velocity 92
    rest
    drum "cp" velocity 93
    rest

    // bar 4 — cp*16
    drum "cp" velocity 94
    drum "cp" velocity 95
    drum "cp" velocity 96
    drum "cp" velocity 97
    drum "cp" velocity 98
    drum "cp" velocity 99
    drum "cp" velocity 100
    drum "cp" velocity 101
    drum "cp" velocity 102
    drum "cp" velocity 103
    drum "cp" velocity 104
    drum "cp" velocity 105
    drum "cp" velocity 106
    drum "cp" velocity 107
    drum "cp" velocity 108
    drum "cp" velocity 110
  }

  // Strudel dropDrums: ~ cp ~ cp | hh*8 | late oh
  pattern drop_clap = steps 1/4 {
    rest
    drum "cp" velocity 96
    rest
    drum "cp" velocity 96
  }

  pattern drop_hh = steps 1/8 {
    drum "hh" velocity 38
    drum "hh" velocity 64
    drum "hh" velocity 38
    drum "hh" velocity 64
    drum "hh" velocity 38
    drum "hh" velocity 64
    drum "hh" velocity 38
    drum "hh" velocity 64
  }

  pattern drop_oh = steps 1/8 {
    rest
    rest
    rest
    rest
    rest
    rest
    rest
    drum "oh" velocity 70
  }

  pattern riser_hold = sequence {
    note C4 for 4bar
  }

  // ─────────────────────────────────────────────
  // Tracks — pitched
  // ─────────────────────────────────────────────

  track arp role harmony {
    instrument music_box
    volume -8 db

    play arpeggio

    effect reverb {
      mix 0.6
      size 0.8
    }
  }

  track arp_drop role harmony {
    instrument music_box
    volume -14 db

    play arpeggio |> repeat 2

    effect reverb {
      mix 0.5
      size 0.7
    }
  }

  track pad role harmony {
    instrument warm_pad
    volume -10 db

    play pad_chords

    effect reverb {
      mix 0.5
      size 0.7
    }
  }

  track pad_build role harmony {
    instrument warm_pad
    volume -7 db

    play pad_chords

    effect reverb {
      mix 0.5
      size 0.7
    }
  }

  track fb_chords role harmony {
    instrument fb_saw
    volume -6 db

    play drop_chords |> trigger_with chord_stabs |> gate 90% |> repeat 2

    effect filter {
      cutoff 1400hz
      resonance 0.55
    }

    automate cutoff {
      lfo sine {
        range 1400hz..5200hz
        rate 2 cycles/bar
      }
    }
  }

  track vox role lead {
    instrument voice_oohs
    volume -9 db

    play drop_chords |> trigger_with vox_hits |> gate 50% |> repeat 2

    effect reverb {
      mix 0.55
      size 0.7
    }
  }

  track vox_outro role lead {
    instrument voice_oohs
    volume -14 db

    play drop_chords |> trigger_with vox_hits |> gate 50%

    effect reverb {
      mix 0.55
      size 0.7
    }
  }

  track bass role bass {
    instrument bass_saw
    volume -3 db

    play bass_roots |> trigger_with bass_pulse |> gate 85% |> repeat 2

    effect filter {
      cutoff 500hz
      resonance 0.2
    }
  }

  track lead role lead {
    volume -5 db

    layer {
      use lead_tone {
        play lead_line |> gate 85% |> repeat 2
      }

      use lead_tone {
        play lead_line |> gate 85% |> transpose 12 st |> gain 0.2 |> repeat 2
      }
    }

    effect delay {
      mix 0.25
      time 1/4
      feedback 0.2
    }
  }

  // ─────────────────────────────────────────────
  // Tracks — drums / riser
  // ─────────────────────────────────────────────

  track light_hh role drums {
    instrument tr909
    volume -12 db

    play light_hh |> repeat 4
  }

  track light_rim role drums {
    instrument tr909
    volume -10 db

    play light_rim |> repeat 4

    effect reverb {
      mix 0.25
      size 0.4
    }
  }

  // Outro light drums a bit louder (Strudel lightDrums.gain(.6))
  track light_hh_outro role drums {
    instrument tr909
    volume -8 db

    play light_hh |> repeat 4
  }

  track light_rim_outro role drums {
    instrument tr909
    volume -7 db

    play light_rim |> repeat 4

    effect reverb {
      mix 0.3
      size 0.45
    }
  }

  track build_kick role drums {
    instrument tr909
    volume -2 db

    play four_on_floor |> repeat 4
  }

  track snare_roll role drums {
    instrument tr909
    volume -6 db

    play snare_roll

    effect reverb {
      mix 0.3
      size 0.5
    }
  }

  track riser role fx {
    instrument riser_noise
    volume -12 db

    play riser_hold

    // Strudel: lpf(saw.range(400, 9000).slow(4)) over the 4-bar build
    effect filter {
      cutoff 400hz
      resonance 0.15
    }

    automate cutoff {
      lfo triangle {
        range 400hz..9000hz
        rate 0.25 cycles/bar
      }
    }
  }

  track drop_clap role drums {
    instrument tr909
    volume -4 db

    play drop_clap |> repeat 8

    effect reverb {
      mix 0.3
      size 0.5
    }
  }

  track drop_hh role drums {
    instrument tr909
    volume -10 db

    play drop_hh |> repeat 8
  }

  track drop_oh role drums {
    instrument tr909
    volume -9 db

    play drop_oh |> repeat 8

    effect reverb {
      mix 0.25
      size 0.45
    }
  }

  // ─────────────────────────────────────────────
  // Arrangement
  // ─────────────────────────────────────────────

  section intro bars 4 {
    parallel exact {

      play track arp
      play track pad
      play track light_hh
      play track light_rim
    }
  }

  section build bars 4 {
    parallel exact {

      play track arp
      play track pad_build
      play track build_kick
      play track snare_roll
      play track riser
    }
  }

  section drop bars 8 {
    parallel exact {

      play track fb_chords
      play track vox
      play track bass
      play track lead
      play track arp_drop
      play track drop_clap
      play track drop_hh
      play track drop_oh
    }
  }

  section outro bars 4 {
    parallel exact {

      play track arp
      play track pad
      play track vox_outro
      play track light_hh_outro
      play track light_rim_outro
    }
  }

  arrangement {
    play intro
    play build
    play drop
    play outro
  }

  master {
    limiter {

      ceiling -0.3 db
    }
  }
}
